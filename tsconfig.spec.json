{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "types": [
      "node",
      "jest"
    ],
    "isolatedModules": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.ts"
  ]
}